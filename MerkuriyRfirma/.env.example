# Django Core Settings
DEBUG=False
SECRET_KEY=generate-a-strong-random-key-here
ALLOWED_HOSTS=*

# CORS Settings (Netlify Integration)
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=https://your-site.netlify.app

# Email SMTP Settings (for customer leads & inquiries)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Merkuriy-R Xususiy qurilish firmasi <noreply@merkuriy-r.uz>
NOTIFY_EMAIL_RECIPIENTS=info@merkuriy-r.uz

# Google Sheets Integration (Optional)
GOOGLE_SERVICE_ACCOUNT_FILE=google_service_account.json
GOOGLE_SHEET_KEY=
